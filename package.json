{
  "name": "hanumoka-site",
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": "^24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "notices": "node scripts/generate-notices.mjs",
    "build": "npm run content:export && npm run notices && astro check && astro build && node scripts/index-search.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check:dist": "node scripts/check-dist.mjs && node scripts/check-editorial.mjs",
    "test:interactive": "node --experimental-strip-types --test scripts/interactive.test.mjs scripts/document-graph.test.mjs scripts/editorial-rules.test.mjs",
    "content:export": "node scripts/content-export.mjs",
    "diagram:render": "node scripts/render-diagram.mjs",
    "image:import": "node scripts/import-image.mjs",
    "test:content": "node --test scripts/content-export.test.mjs",
    "predev": "npm run content:export"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.3",
    "dayjs": "^1.11.21",
    "lodash.kebabcase": "^4.1.1",
    "mermaid": "^11.17.2",
    "rehype-callouts": "^2.2.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.2",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "fflate": "^0.8.3",
    "pagefind": "^1.5.2",
    "parse5": "8.0.1",
    "prettier": "3.9.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "remark-parse": "^11.0.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "private": true
}
