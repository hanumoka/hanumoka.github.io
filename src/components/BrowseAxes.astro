---
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveLocale } from "@/utils/locales";
import { useTranslations } from "@/i18n";

/**
 * 분류 축이 셋이 되면서 「A 별로도 볼 수 있습니다」 한 줄로는 모자란다.
 * 지금 보고 있는 축을 빼고 나머지를 나열한다.
 */
type Axis = "tags" | "kinds" | "series" | "tree";

type Props = { current: Axis };

const { current } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const AXES: { key: Axis; label: string; href: string }[] = [
  { key: "tags", label: t.pages.tagsTitle, href: "tags/" },
  { key: "kinds", label: t.pages.kindsTitle, href: "kinds/" },
  { key: "series", label: t.pages.seriesTitle, href: "series/" },
  { key: "tree", label: t.pages.treeTitle, href: "tree/" },
];

const others = AXES.filter(axis => axis.key !== current);
---

<p
  class="text-muted-foreground mt-10 flex flex-wrap items-baseline gap-x-2 text-sm"
>
  <span>{t.pages.alsoBrowseBy}</span>
  {
    others.map((axis, index) => (
      <>
        {index > 0 && <span aria-hidden="true">·</span>}
        <a
          href={getRelativeLocaleUrl(locale, axis.href)}
          class="hover:text-accent underline decoration-dashed underline-offset-4"
        >
          {axis.label}
        </a>
      </>
    ))
  }
</p>
