---
import { getRelativeLocaleUrl } from "astro:i18n";
import { BROWSE_AXES, type BrowseAxis } from "@/catalog";
import { resolveLocale } from "@/utils/locales";
import { useTranslations } from "@/i18n";

/**
 * 분류 축이 셋이 되면서 「A 별로도 볼 수 있습니다」 한 줄로는 모자란다.
 * 지금 보고 있는 축을 빼고 나머지를 나열한다. 축 목록은 `src/catalog.ts` 가 정본이다.
 */

type Props = { current: BrowseAxis };

const { current } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const labels: Record<BrowseAxis, string> = {
  tags: t.pages.tagsTitle,
  kinds: t.pages.kindsTitle,
  series: t.pages.seriesTitle,
  tree: t.pages.treeTitle,
};

const AXES = BROWSE_AXES.map(key => ({
  key,
  label: labels[key],
  href: `${key}/`,
}));

const others = AXES.filter(axis => axis.key !== current);
---

<p
  class="text-muted-foreground mt-10 flex flex-wrap items-baseline gap-x-2 text-sm"
>
  <span>{t.pages.alsoBrowseBy}</span>
  {
    others.map((axis, index) => (
      <>
        {index > 0 && <span aria-hidden="true">·</span>}
        <a
          href={getRelativeLocaleUrl(locale, axis.href)}
          class="hover:text-accent underline decoration-dashed underline-offset-4"
        >
          {axis.label}
        </a>
      </>
    ))
  }
</p>
