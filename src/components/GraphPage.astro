---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import DocumentGraph from "./DocumentGraph.astro";
import { getDocumentGraph } from "@/utils/getDocumentGraph";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import type { Locale } from "@/utils/locales";
import config from "@/config";
type Props = { locale: Locale; review?: boolean };
const { locale, review = false } = Astro.props;
const t = useTranslations(locale);
const graph = await getDocumentGraph(locale, review);
const title = review ? t.graph.review : t.graph.published;
---

<Layout
  title={`${title} | ${config.site.title}`}
  description={t.graph.description}
  noindex={review || graph.nodes.length === 0}
>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-6xl px-4 py-8">
    <h1 class="mb-3 text-2xl font-semibold">{title}</h1>
    <p class="text-muted-foreground mb-4">{t.graph.description}</p>
    <nav class="mb-6 flex flex-wrap gap-5 text-sm" aria-label={t.nav.graph}>
      <a
        href={getRelativeLocaleUrl(locale, "graph/")}
        aria-current={!review ? "page" : undefined}
        class="text-accent underline">{t.graph.published}</a
      >
      <a
        href={getRelativeLocaleUrl(locale, "drafts/graph/")}
        aria-current={review ? "page" : undefined}
        class="text-accent underline">{t.graph.review}</a
      >
      <a
        href={getRelativeLocaleUrl(locale, "drafts/")}
        class="text-accent underline">{t.nav.drafts}</a
      >
    </nav>
    <DocumentGraph {...graph} locale={locale} />
  </main>
  <Footer />
</Layout>
