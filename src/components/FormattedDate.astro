---
interface Props {
  date: Date;
}

const { date } = Astro.props;

// 빌드 머신의 로캘에 따라 결과가 달라지지 않도록 로캘과 시간대를 고정한다.
const formatted = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Seoul',
}).format(date);
---

<time datetime={date.toISOString()}>{formatted}</time>
