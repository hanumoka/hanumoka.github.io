---
import type { MarkdownHeading } from "astro";
import { resolveLocale } from "@/utils/locales";
import { useTranslations } from "@/i18n";

type Props = {
  headings: MarkdownHeading[];
  /** 넓은 화면의 고정 사이드바인가, 좁은 화면의 접이식인가 */
  variant: "sidebar" | "inline";
};

const { headings, variant } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

// h2·h3 만 담는다. h4 아래까지 넣으면 트리가 글보다 길어진다.
const items = headings.filter(h => h.depth === 2 || h.depth === 3);
const minDepth = Math.min(...items.map(h => h.depth));
---

{
  items.length > 1 &&
    (variant === "sidebar" ? (
      <nav
        data-pagefind-ignore
        aria-labelledby="toc-heading-sidebar"
        class="toc-sidebar text-sm"
      >
        <h2
          id="toc-heading-sidebar"
          class="text-muted-foreground mb-2 text-xs font-semibold tracking-wide uppercase"
        >
          {t.post.tableOfContents}
        </h2>
        <ol class="border-border flex flex-col gap-1 border-s ps-3">
          {items.map(heading => (
            <li class:list={[{ "ps-3": heading.depth > minDepth }]}>
              <a
                href={`#${heading.slug}`}
                data-toc-link={heading.slug}
                class="text-muted-foreground hover:text-accent block leading-snug transition-colors"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    ) : (
      <details
        data-pagefind-ignore
        class="border-border mb-8 border-s ps-4 xl:hidden"
      >
        <summary class="text-muted-foreground cursor-pointer text-sm font-semibold">
          {t.post.tableOfContents}
        </summary>
        <ol class="mt-2 flex flex-col gap-1 text-sm">
          {items.map(heading => (
            <li class:list={[{ "ps-4": heading.depth > minDepth }]}>
              <a
                href={`#${heading.slug}`}
                data-toc-link={heading.slug}
                class="text-muted-foreground hover:text-accent block leading-snug"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    ))
}

<style>
  /* ★ 본문은 가운데 정렬된 고정 폭(max-w-3xl = 48rem)이다. 그 왼쪽 여백에
     목차를 세우려면 화면 중앙에서 거꾸로 계산해야 한다 —
     본문 왼쪽 끝이 `50vw - 24rem` 이고, 간격 1.5rem 과 목차 폭 13rem 을 뺀다.
     여백이 모자라는 좁은 화면에서는 접이식 쪽만 보인다. */
  .toc-sidebar {
    display: none;
  }

  @media (min-width: 1280px) {
    .toc-sidebar {
      display: block;
      position: fixed;
      top: 9rem;
      inset-inline-start: calc(50vw - 38.5rem);
      width: 13rem;
      max-height: calc(100vh - 12rem);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }

  /* 지금 보고 있는 절 */
  .toc-sidebar a[aria-current="true"],
  details a[aria-current="true"] {
    color: var(--color-accent);
    font-weight: 600;
  }
</style>
