---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import { hasOfficialTerm } from "@/utils/hasListingEntries";
import { resolveLocale } from "@/utils/locales";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
// 태그 페이지는 정식 글에서만 만든다. 초안에만 있는 태그를 그 주소로 링크하면 404다.
const listed = await hasOfficialTerm("tags", locale, tag);

const classList = [
  "flex items-center gap-0.5",
  {
    "border-foreground border-b-2 border-dashed": listed,
    "hover:border-accent hover:text-accent hover:-mt-0.5": listed,
    "focus-visible:text-accent focus-visible:border-none": listed,
    "text-sm": size === "sm",
    "text-lg": size === "lg",
  },
];

const iconClassList = [
  "opacity-80",
  { "size-5": size === "lg" },
  { "size-4": size === "sm" },
];
---

<li>
  {
    listed ? (
      <a
        href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
        transition:name={tag}
        class:list={classList}
      >
        <IconHash class:list={iconClassList} />
        {tagName}
      </a>
    ) : (
      <span class:list={classList}>
        <IconHash class:list={iconClassList} />
        {tagName}
      </span>
    )
  }
</li>
