---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { KIND_LABEL, countByKind, getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
const kinds = countByKind(posts);
---

<Base title="글" description="hanumoka가 쓴 기술 글 목록.">
  <h1>글</h1>
  <p class="muted count small">{posts.length}편</p>

  {
    kinds.size > 0 && (
      <nav class="kinds" aria-label="종류별 보기">
        {[...kinds].map(([kind, n]) => (
          <a href={`/kinds/${kind}/`}>
            {KIND_LABEL[kind]} <span class="n">{n}</span>
          </a>
        ))}
        <a href="/tags/">태그 전체</a>
      </nav>
    )
  }

  <PostList posts={posts} empty="아직 공개한 글이 없습니다." />
</Base>

<style>
  .count {
    margin: 0 0 1.25rem;
  }
  .kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .kinds a {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.2rem 0.75rem;
    text-decoration: none;
  }
  .n {
    color: var(--muted);
    font-size: 0.8rem;
  }
</style>
