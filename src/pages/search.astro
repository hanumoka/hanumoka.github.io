---
import Search from 'astro-pagefind/components/Search.astro';
import Base from '../layouts/Base.astro';
---

<Base title="검색" description="글 검색.">
  <h1>검색</h1>

  <div class="search">
    <Search
      id="search"
      className="pagefind-ui"
      uiOptions={{ showImages: false, excerptLength: 24 }}
    />
  </div>

  <noscript>
    <p class="muted">검색에는 자바스크립트가 필요합니다. <a href="/posts/">글 목록</a>을 이용하세요.</p>
  </noscript>
</Base>

<style is:global>
  /* Pagefind UI가 자기 CSS 변수로 색을 받으므로 사이트 토큰에 맞춘다. */
  .pagefind-ui {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--fg);
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--line);
    --pagefind-ui-tag: var(--bg);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: var(--font-sans);
  }
  .search {
    margin-top: 2rem;
  }
</style>
