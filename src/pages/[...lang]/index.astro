---
import { getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import HomeFeed from "@/components/HomeFeed.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedDrafts, getSortedPosts } from "@/utils/getSortedPosts";
import { getLocalizedPosts } from "@/utils/getLocalizedPosts";
import { localePaths, resolveLocale, getLocaleFileUrl } from "@/utils/locales";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const getStaticPaths = localePaths;

const { socials, posts: postsConfig, site } = config;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const home = await getEntry("pages", `${locale}/home`);
if (!home) {
  throw new Error(`Missing content entry: src/content/pages/${locale}/home.md`);
}
const { Content: HomeIntro } = await render(home);

const official = getSortedPosts(await getLocalizedPosts(locale));
const drafts = getSortedDrafts(
  await getLocalizedPosts(locale, { includeDrafts: true })
);
const showingDrafts = official.length === 0 && drafts.length > 0;
const featured = official.filter(({ data }) => data.featured);
const rest = official.filter(({ data }) => !data.featured);
const feed = (showingDrafts ? drafts : [...featured, ...rest]).slice(
  0,
  postsConfig.perIndex
);
const listHref = getRelativeLocaleUrl(
  locale,
  showingDrafts ? "drafts" : "posts"
);
const listLabel = showingDrafts ? t.home.allDrafts : t.home.allPosts;
const feedHeading = showingDrafts ? t.home.recentDrafts : t.home.recentPosts;
const interests =
  locale === "ko"
    ? ["Kotlin", "Spring", "이벤트 기반", "배포와 운영"]
    : ["Kotlin", "Spring", "event-driven", "operations"];
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout-wide py-8 sm:py-12"
  >
    <div class="home-bench">
      <section class="home-who" aria-labelledby="home-name">
        <h1
          id="home-name"
          class="text-4xl font-semibold tracking-tight sm:text-5xl"
        >
          {site.title}
        </h1>
        <div class="app-prose home-intro mt-5 max-w-[32ch]">
          <HomeIntro />
        </div>
        <ul class="mt-7 flex flex-wrap gap-2">
          {
            interests.map(item => (
              <li class="bg-muted text-muted-foreground rounded-full px-2.5 py-1 text-xs">
                {item}
              </li>
            ))
          }
        </ul>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          {socials.length > 0 && <Socials />}
          <a
            href={getLocaleFileUrl(locale, "rss.xml")}
            class="text-accent text-sm"
            title={t.home.rssFeed}
          >
            <IconRss
              width={18}
              height={18}
              class="stroke-accent me-1 inline-block stroke-2 align-text-bottom rtl:-rotate-90"
            />
            {t.home.rssFeed}
          </a>
        </div>
      </section>

      <section class="home-stream" aria-labelledby="home-feed-heading">
        {
          feed.length > 0 ? (
            <>
              <h2
                id="home-feed-heading"
                class="text-muted-foreground mb-2 text-sm font-medium"
              >
                {feedHeading}
              </h2>
              <HomeFeed posts={feed} />
              <div class="mt-8">
                <LinkButton href={listHref}>
                  {listLabel}
                  <IconArrowRight class="inline-block rtl:-rotate-180" />
                </LinkButton>
              </div>
            </>
          ) : (
            <p class="text-muted-foreground">{t.pages.listEmpty}</p>
          )
        }
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
