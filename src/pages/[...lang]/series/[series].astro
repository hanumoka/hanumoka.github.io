---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import { getLocalizedPosts } from "@/utils/getLocalizedPosts";
import { getUniqueSeries, getSeriesPosts } from "@/utils/getUniqueSeries";
import { localePaths, resolveLocale } from "@/utils/locales";
import { DEFAULT_LOCALE } from "@/catalog";
import { SERIES, seriesLabel, type SeriesKey } from "@/series";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

/**
 * ★ 연재 페이지는 페이지네이션을 두지 않는다. 태그·종류와 다른 점이다.
 * 연재는 **순서가 본질**이라 몇 편이 다음 장으로 넘어가면 그 순서가 끊긴다.
 */
export async function getStaticPaths() {
  const routes = [];

  for (const { params, props } of localePaths()) {
    const posts = await getLocalizedPosts(props.locale);
    const listed = getUniqueSeries(posts);

    for (const { series } of listed) {
      routes.push({
        params: { lang: params.lang, series },
        props: {
          seriesKey: series,
          redirectTo: undefined as SeriesKey | undefined,
        },
      });
    }

    // 옛 한글 주소는 기본 언어에만 있었다. GitHub Pages 는 서버 넘김이
    // 없으므로 그 자리에 정적 넘김 페이지를 둔다.
    if (props.locale === DEFAULT_LOCALE) {
      for (const { series } of listed) {
        for (const old of SERIES[series].legacySlugs) {
          routes.push({
            params: { lang: params.lang, series: old },
            props: { seriesKey: series, redirectTo: series },
          });
        }
      }
    }
  }

  return routes;
}

const { seriesKey, redirectTo } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const seriesName = seriesLabel(seriesKey, locale);
const dest = redirectTo
  ? getRelativeLocaleUrl(locale, `series/${redirectTo}/`)
  : null;
const destAbs = dest ? new URL(dest, Astro.site).href : null;
const parts = dest
  ? []
  : getSeriesPosts(await getLocalizedPosts(locale), seriesKey);
---

{
  dest && destAbs ? (
    <html lang={locale}>
      <head>
        <meta charset="utf-8" />
        <title>{seriesName}</title>
        <link rel="canonical" href={destAbs} />
        <meta http-equiv="refresh" content={`0;url=${dest}`} />
        <meta name="robots" content="noindex, follow" />
        <script is:inline define:vars={{ dest }}>
          location.replace(dest);
        </script>
      </head>
      <body>
        <a href={dest}>{seriesName}</a>
      </body>
    </html>
  ) : (
    <Layout
      title={`${t.pages.seriesOneTitle}: ${seriesName} | ${config.site.title}`}
    >
      <Header />

      <Breadcrumb />

      <Main
        pageTitle={`${t.pages.seriesOneTitle}: ${seriesName}`}
        pageDesc={`${t.pages.seriesOneDesc} "${seriesName}".`}
      >
        <ol class="flex flex-col">
          {parts.map(data => (
            <Card {...data} />
          ))}
        </ol>
      </Main>

      <Footer />
    </Layout>
  )
}
