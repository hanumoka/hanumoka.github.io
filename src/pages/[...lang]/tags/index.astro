---
import { getLocalizedPosts } from "@/utils/getLocalizedPosts";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { useTranslations } from "@/i18n";
import { localePaths, resolveLocale } from "@/utils/locales";
import config from "@/config";

export const getStaticPaths = localePaths;

const locale = resolveLocale(Astro.currentLocale);
const posts = await getLocalizedPosts(locale);
const tags = getUniqueTags(posts);

const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    <ul class="flex flex-wrap gap-6">
      {tags.map(({ tag, tagName }) => <Tag {tag} {tagName} />)}
    </ul>

    <p class="mt-10 text-sm opacity-80">
      {t.pages.alsoBrowseByPrefix}<a
        href={getRelativeLocaleUrl(locale, "kinds/")}
        class="hover:text-accent underline decoration-dashed underline-offset-4"
      >
        {t.pages.kindsTitle}
      </a>{t.pages.alsoBrowseBySuffix}
    </p>
  </Main>

  <Footer />
</Layout>
