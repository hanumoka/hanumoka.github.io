---
import { getLocalizedPosts } from "@/utils/getLocalizedPosts";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import BrowseAxes from "@/components/BrowseAxes.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getUniqueKinds } from "@/utils/getUniqueKinds";
import { useTranslations } from "@/i18n";
import { localePaths, resolveLocale } from "@/utils/locales";
import config from "@/config";

export const getStaticPaths = localePaths;

const locale = resolveLocale(Astro.currentLocale);
const posts = await getLocalizedPosts(locale);
const kinds = getUniqueKinds(posts);

const t = useTranslations(locale);
---

<Layout
  title={`${t.pages.kindsTitle} | ${config.site.title}`}
  noindex={kinds.length === 0}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.kindsTitle} pageDesc={t.pages.kindsDesc}>
    {
      kinds.length === 0 && (
        <p class="text-muted-foreground">{t.pages.listEmpty}</p>
      )
    }
    <ul class="flex flex-col gap-3">
      {
        kinds.map(({ kind, count }) => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `kinds/${kind}/`)}
              class="hover:text-accent inline-flex items-baseline gap-2 underline decoration-dashed underline-offset-4"
            >
              <span>{t.kinds[kind as keyof typeof t.kinds] ?? kind}</span>
              <span class="text-sm opacity-70">{count}</span>
            </a>
            <span class="ms-1 text-sm opacity-50">{kind}</span>
          </li>
        ))
      }
    </ul>

    <BrowseAxes current="kinds" />
  </Main>

  <Footer />
</Layout>
