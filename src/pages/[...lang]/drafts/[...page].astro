---
import type { GetStaticPaths } from "astro";
import { getLocalizedPosts } from "@/utils/getLocalizedPosts";
import { localePaths, resolveLocale } from "@/utils/locales";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getSortedDrafts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const routes = [];
  for (const { params, props } of localePaths()) {
    const posts = await getLocalizedPosts(props.locale, {
      includeDrafts: true,
    });
    const drafts = getSortedDrafts(posts);
    const pages = paginate(drafts, {
      pageSize: config.posts.perPage,
    });
    // 초안이 없어도 목록 페이지는 만든다. 헤더 링크가 404가 되면 안 된다.
    if (pages.length === 0) {
      routes.push({
        params: { lang: params.lang },
        props: {
          page: {
            data: [],
            start: 0,
            end: -1,
            size: config.posts.perPage,
            total: 0,
            currentPage: 1,
            lastPage: 1,
            url: {
              current: "/drafts",
              prev: undefined,
              next: undefined,
              first: "/drafts",
              last: "/drafts",
            },
          },
        },
      });
    } else {
      routes.push(
        ...pages.map(route => ({
          ...route,
          params: { ...route.params, lang: params.lang },
        }))
      );
    }
  }
  return routes;
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<Layout
  title={`${t.pages.draftsTitle} | ${config.site.title}`}
  noindex={page.total === 0}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.draftsTitle} pageDesc={t.pages.draftsDesc}>
    {
      page.total === 0 && (
        <p class="text-muted-foreground">{t.pages.listEmpty}</p>
      )
    }
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
