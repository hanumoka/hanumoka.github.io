---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import {
  KIND_LABEL,
  getPublishedPosts,
  type Kind,
  type Post,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const kinds = new Set(
    posts.map((post) => post.data.kind).filter((k): k is Kind => Boolean(k)),
  );

  return [...kinds].map((kind) => ({
    params: { kind },
    props: { posts: posts.filter((post) => post.data.kind === kind) },
  }));
}

interface Props {
  posts: Post[];
}

const kind = Astro.params.kind as Kind;
const { posts } = Astro.props;
const label = KIND_LABEL[kind];
---

<Base title={label} description={`${label} 종류의 글.`}>
  <h1>{label}</h1>
  <p class="muted count small">{kind} · {posts.length}편</p>
  <PostList posts={posts} empty="이 종류의 글이 없습니다." />
  <p class="small back"><a href="/posts/">← 글 전체</a></p>
</Base>

<style>
  .count {
    margin: 0 0 2.5rem;
  }
  .back {
    margin-top: 3rem;
  }
</style>
