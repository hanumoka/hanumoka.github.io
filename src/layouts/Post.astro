---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { KIND_LABEL } from '../lib/posts';
import Base from './Base.astro';

type Props = CollectionEntry<'posts'>['data'];

const { title, description, pubDate, updatedDate, kind, tags } = Astro.props;
---

<Base title={title} description={description}>
  <article>
    <h1>{title}</h1>
    <p class="meta muted small">
      <FormattedDate date={pubDate} />
      {updatedDate && <span> · 수정 <FormattedDate date={updatedDate} /></span>}
      {kind && <span> · <a href={`/kinds/${kind}/`}>{KIND_LABEL[kind]}</a></span>}
    </p>

    <div class="body" data-pagefind-body>
      <slot />
    </div>

    {
      tags.length > 0 && (
        <p class="tags small">
          {tags.map((t) => (
            <a href={`/tags/${t}/`}>#{t}</a>
          ))}
        </p>
      )
    }
  </article>

  <p class="small back"><a href="/posts/">← 글 목록</a></p>
</Base>

<style>
  .meta {
    margin: 0 0 2.5rem;
  }
  .body :global(h2) {
    margin-top: 2.5rem;
  }
  .body :global(h2:first-child) {
    margin-top: 0;
  }
  .tags {
    margin-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .tags a {
    text-decoration: none;
    color: var(--muted);
  }
  .tags a:hover {
    color: var(--accent);
  }
  .back {
    margin-top: 2rem;
  }
</style>
